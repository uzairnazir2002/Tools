{
  "name": "codeformattertools",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "turbo dev --filter=web",
    "start": "pnpm --filter web start",
    "build": "turbo build",
    "lint": "eslint apps/web packages tests playwright.config.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "playwright test",
    "benchmark:json": "node --experimental-strip-types tests/performance/json-benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  }
}
